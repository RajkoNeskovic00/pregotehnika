{% extends 'base.html.twig' %}

{% block title %}
    {{ 'about.title'|trans }}
{% endblock %}

{% block body %}

<section class="about-section">

    <div class="about-overlay"></div>

    <div class="container position-relative">

        <div class="text-center mb-5 about-header">

            <h1 class="fw-bold">
                {{ 'about.heading'|trans }}
            </h1>

            <p>
                {{ 'about.subtitle'|trans }}
            </p>

        </div>

        <div class="about-content shadow-sm">

            <div class="about-block">

                <h3>
                    {{ 'about.company_heading'|trans }}
                </h3>

                <p>
                    {{ 'about.company_text'|trans|raw }}
                </p>

            </div>

            <div class="about-stats">
                <div class="stat-box">
                    <strong>2004.</strong>
                    <span>{{ 'about.stat_founded'|trans }}</span>
                </div>
                <div class="stat-box">
                    <strong>25+</strong>
                    <span>{{ 'about.stat_experience'|trans }}</span>
                </div>
                <div class="stat-box">
                    <strong>100%</strong>
                    <span>{{ 'about.stat_quality'|trans }}</span>
                </div>
            </div>

            <div class="about-block">

                <h3>
                    {{ 'about.tech_heading'|trans }}
                </h3>

                <p>
                    {{ 'about.tech_text'|trans|raw }}
                </p>

            </div>

            <div class="about-block">
                <h3>
                    {{ 'about.tissue_heading'|trans }}
                </h3>
                <p>
                    {{ 'about.tissue_text'|trans|raw }}
                </p>
            </div>
            <div class="about-block">
                <h3>
                    {{ 'about.partner_heading'|trans }}
                </h3>
                <p>
                    {{ 'about.partner_text'|trans|raw }}
                </p>
            </div>
        </div>

        {# Galerija #}
        <div class="about-gallery mt-5">
            <h2 class="text-center mb-4 text-white">
                {{ 'about.gallery_heading'|trans }}
            </h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <a href="{{ asset('images/about/alu-new.png') }}" class="gallery-item lightbox">
                        <img src="{{ asset('images/about/alu-new.png') }}" alt="engraved_rollers_for_aluminum_foil">
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ asset('images/about/rolls-for-napkins-and-tissues.webp') }}" class="gallery-item lightbox">
                        <img src="{{ asset('images/about/rolls-for-napkins-and-tissues.webp') }}" alt="rolls-for-napkins-and-tissues">
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ asset('images/about/rolls-for-toilet-paper-and-paper-towels.png') }}" class="gallery-item lightbox">
                        <img src="{{ asset('images/about/rolls-for-toilet-paper-and-paper-towels.png') }}" alt="rolls-for-toilet-paper-and-paper-towels">
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ asset('images/about/complete-embossing-section_back.webp') }}" class="gallery-item lightbox">
                        <img src="{{ asset('images/about/complete-embossing-section_back.webp') }}" alt="complete-embossing-section_back">
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ asset('images/about/complete-embossing-section_front.webp') }}" class="gallery-item lightbox">
                        <img src="{{ asset('images/about/complete-embossing-section_front.webp') }}" alt="complete-embossing-section_front">
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ asset('images/about/medicinske_komprese_eos.png') }}" class="gallery-item lightbox">
                        <img src="{{ asset('images/about/medicinske_komprese_eos.png') }}" alt="medicinske_komprese_eos">
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="lightbox" class="lightbox-overlay" hidden>
    <button type="button" class="lightbox-close" aria-label="{{ 'about.lightbox_close'|trans }}">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="{{ 'about.lightbox_prev'|trans }}">‹</button>
    <img src="" alt="">
    <button type="button" class="lightbox-next" aria-label="{{ 'about.lightbox_next'|trans }}">›</button>
</div>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/lightbox.js') }}"></script>
{% endblock %}
