{% extends 'base.html.twig' %}

{% block title %}
    {{ 'products.title'|trans }}
{% endblock %}

{% block body %}

<section class="product-section">

    <div class="container">

        {{ include('product/_breadcrumb.html.twig') }}

        <div class="text-center mb-5 faq-header">
            <h1 class="fw-bold text-navy">
                {{ 'products.heading'|trans }}
            </h1>
            <p class="lead-text">
                {{ 'products.subtitle'|trans }}
            </p>
        </div>

        {% for category in categories %}

            {% set activeProducts = category.products|filter(p => p.isActive) %}
            {% set previewProduct = activeProducts|first %}
            {% set previewImage = previewProduct ? previewProduct.mainImage : null %}
            {% set categoryName = localized(category, 'name') %}

            <div class="product-category-card">
                <div class="card-image-left">
                    {% if previewImage %}
                        <a href="{{ asset('uploads/products/' ~ previewImage.imagePath) }}" class="lightbox">
                            <img src="{{ asset('uploads/products/' ~ previewImage.imagePath) }}?v={{ random(100000, 999999) }}"
                                alt="{{ localized(previewImage, 'altText')|default(categoryName) }}">
                        </a>
                    {% elseif category.iTag %}
                        <img src="{{ asset('images/icons/' ~ category.iTag) }}?v={{ random(100000, 999999) }}"
                            alt="{{ categoryName }}"
                            class="card-image-icon">
                    {% else %}
                        <img src="{{ asset('images/products-bg.jpg') }}?v={{ random(100000, 999999) }}"
                            alt="{{ categoryName }}">
                    {% endif %}
                </div>
                <div class="card-content-right">
                    <h3>{{ categoryName }}</h3>

                    {% if activeProducts is not empty %}
                        <p>
                            {{ activeProducts|length }}
                            {% if activeProducts|length == 1 %}
                                {{ 'products.count_one'|trans }}
                            {% else %}
                                {{ 'products.count_many'|trans }}
                            {% endif %}
                            {{ 'products.count_in_category'|trans }}
                        </p>
                    {% else %}
                        <p>{{ 'products.empty_category'|trans }}</p>
                    {% endif %}

                    <a href="{{ path('product_category', {slug: localized_slug(category)}) }}"
                       class="product-link">
                        {{ 'products.more'|trans }}
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

            </div>

        {% else %}

            <p class="text-center text-white">{{ 'products.empty_categories'|trans }}</p>

        {% endfor %}

    </div>

</section>

<div id="lightbox" class="lightbox-overlay" hidden>
    <button type="button" class="lightbox-close" aria-label="{{ 'about.lightbox_close'|trans }}">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="{{ 'about.lightbox_prev'|trans }}">‹</button>
    <img src="" alt="">
    <button type="button" class="lightbox-next" aria-label="{{ 'about.lightbox_next'|trans }}">›</button>
</div>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/lightbox.js') }}"></script>
{% endblock %}
