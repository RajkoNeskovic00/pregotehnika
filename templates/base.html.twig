<!DOCTYPE html>
<html lang="{{ app.request.locale|default('sr') }}">
<head>
    <meta name="robots" content="noindex,nofollow"> {# Bitno za indeksiranje #}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{{ 'meta.default_title'|trans }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ 'meta.default_description'|trans }}{% endblock %}">
    <meta name="robots" content="index, follow">
    <link class="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}">
    <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon.ico') }}">

    {% set route = app.request.attributes.get('_route') %}
    {% set route_params = app.request.attributes.get('_route_params')|default({}) %}
    {% set sr_url = locale_url('sr') %}
    {% set en_url = locale_url('en') %}
    {% if sr_url and en_url %}
        <link rel="alternate" hreflang="sr" href="{{ sr_url }}">
        <link rel="alternate" hreflang="en" href="{{ en_url }}">
        <link rel="alternate" hreflang="x-default" href="{{ sr_url }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}?v={{ random(100000, 999999) }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top py-3">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center gap-2 text-navy" href="{{ path('home') }}">
                    <img src="{{ asset('images/logo.webp') }}" alt="pregotehnika_logo" width="60" height="60" class="d-inline-block align-top img-fluid">
                    <div style="line-height: 1;">
                        <span class="d-block fw-extrabold fs-5" style="font-weight: 800;">PREGOTEHNIKA</span>
                        <small class="text-muted fst-italic d-block text-end" style="font-size: 13px; letter-spacing: 1px;">embossing rolls</small>
                    </div>
                </a>

                {# HAMBURGER DUGME #}
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigacija" aria-controls="navigacija" aria-expanded="false" aria-label="{{ 'nav.toggle'|trans }}">
                    <span class="navbar-toggler-icon"></span>
                </button>

                {# NAV MENU #}
                <div class="collapse navbar-collapse" id="navigacija">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 mt-3 mt-lg-0 align-items-lg-center">
                        {% for item in nav_items|default([]) %}
                            {% if item.children is not empty %}
                                {# GLAVNI DROPDOWN (npr. Proizvodi) #}
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="{% if item.route %}{{ path(item.route) }}{% elseif item.slug == 'products' %}{{ path('products') }}{% else %}{{ path('home') }}{{ item.slug|trim('/') }}{% endif %}"
                                       id="navbarDropdown{{ loop.index }}"
                                       role="button"
                                       aria-expanded="false">
                                        {{ item.title }}
                                    </a>

                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown{{ loop.index }}">
                                        {% for sub in item.children %}
                                            {% set has_products = sub.products is defined and sub.products is not empty %}
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item {% if has_products %}dropdown-toggle{% endif %} d-flex align-items-center py-2" href="{{ path('product_category', {slug: sub.slug}) }}">
                                                    {% if sub.iTag is defined and sub.iTag is not empty %}
                                                        <img src="{{ asset('images/icons/' ~ sub.iTag) }}"
                                                            alt=""
                                                            style="width: 28px; height: 28px; object-fit: contain;"
                                                            class="me-2">
                                                    {% else %}
                                                        <div style="width: 28px;" class="me-2"></div>
                                                    {% endif %}
                                                    <span>{{ sub.title }}</span>
                                                </a>
                                                {% if has_products %}
                                                    <ul class="dropdown-menu submenu">
                                                        {% for product in sub.products %}
                                                            <li>
                                                                <a class="dropdown-item" href="{{ path('product_detail', {categorySlug: sub.slug, slug: product.slug}) }}">
                                                                    {{ product.title }}
                                                                </a>
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                            {% else %}
                                {# OBIČNE STAVKE #}
                                <li class="nav-item {% if item.route and app.request.attributes.get('_route') == item.route %}active{% endif %}">
                                    <a class="nav-link" href="{% if item.route %}{{ path(item.route) }}{% else %}{{ path('home') }}{% endif %}">{{ item.title }}</a>
                                </li>
                            {% endif %}
                        {% endfor %}

                        <li class="nav-item ms-lg-3">
                            <div class="lang-switcher d-flex gap-2 align-items-center">
                                {% set sr_path = locale_path('sr') %}
                                {% set en_path = locale_path('en') %}
                                {% if sr_path and en_path %}
                                    <a class="lang-link{% if app.request.locale == 'sr' %} is-active{% endif %}"
                                       href="{{ sr_path }}"
                                       hreflang="sr">{{ 'nav.sr'|trans }}</a>
                                    <span class="text-muted">|</span>
                                    <a class="lang-link{% if app.request.locale == 'en' %} is-active{% endif %}"
                                       href="{{ en_path }}"
                                       hreflang="en">{{ 'nav.en'|trans }}</a>
                                {% endif %}
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    {{ include('fixed/footer.html.twig') }}

    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
