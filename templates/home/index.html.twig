{% extends 'base.html.twig' %}
{% set footer = footer_data() %}

{% block title %}
    {{ 'home.title'|trans }}
{% endblock %}

{% block body %}

    <section class="hero-banner">

        <div class="container">

            <div
                class="row gy-5">
                {# INFORMACIJE O PROIZVODU - PRVO NA MOBILNOM #}

                <div class="col-lg-6 order-1 order-lg-1">
                    <h1 class="hero-title">
                        {{ 'home.hero_line1'|trans }}<br>
                        {{ 'home.hero_line2'|trans }}<br>
                        {{ 'home.hero_line3'|trans }}
                    </h1>
                    <p class="hero-text">
                        {{ 'home.hero_text'|trans }}
                    </p>
                    <a href="{{ path('about') }}" class="btn bg-navy text-white hero-btn">
                        {{ 'home.cta_more'|trans }}
                    </a>
                </div>

                <div class="col-12 order-2 order-lg-3">

                    <div class="hero-info-card">

                        <div class="row align-items-center g-4">

                            <div class="col-lg-7">

                                <h2>
                                    {{ 'home.info_title'|trans }}
                                </h2>

                                <p>
                                    {{ 'home.info_p1'|trans|raw }}
                                </p>

                                <p>
                                    {{ 'home.info_p2'|trans|raw }}
                                </p>

                                <p>
                                    {{ 'home.info_p3'|trans }}
                                </p>

                            </div>

                            <div class="col-lg-5">

                                <img src="/images/valjak_sara.jpg" class="hero-info-image" alt="{{ 'home.info_image_alt'|trans }}">

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-6 d-flex justify-content-lg-end order-3 order-lg-2">

                    <div class="contact-card">

                        <h4 class="contact-card-title">

                            {{ 'home.contact_title'|trans }}

                        </h4>

                        {% for setting in footer.settings %}

                            <div class="contact-card-item">

                                <span class="icon">

                                    <i class="{{ setting.iTag }}"></i>

                                </span>

                                <span>

                                    {{ setting.value }}

                                </span>

                            </div>

                        {% endfor %}

                        <a href="{{ path('contact') }}" class="btn btn-navy-outline w-100 mt-4">

                            {{ 'home.cta_offer'|trans }}

                        </a>

                    </div>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
