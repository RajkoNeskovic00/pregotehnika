{% extends 'base.html.twig' %}

{% set categoryName = localized(category, 'name') %}

{% block title %}
    {{ categoryName }} | Pregotehnika
{% endblock %}

{% block body %}

<section class="product-section">

    <div class="container">

        {{ include('product/_breadcrumb.html.twig', {category: category}) }}

        <div class="text-center mb-5 faq-header">
            <h1 class="fw-bold text-navy">
                {{ categoryName }}
            </h1>
            <p class="lead-text">
                {{ 'products.category_subtitle'|trans }}
            </p>
        </div>

        {% if products is empty %}

            <div class="hero-info-card text-center">
                <p class="mb-0">{{ 'products.empty_category'|trans }}</p>
            </div>

        {% else %}

            {% for product in products %}

                {% set mainImage = product.mainImage %}
                {% set productName = localized(product, 'name') %}

                <div class="product-category-card">
                    <div class="card-image-left">
                        {% if mainImage %}
                            <a href="{{ asset('uploads/products/' ~ mainImage.imagePath) }}" class="lightbox">
                                <img src="{{ asset('uploads/products/' ~ mainImage.imagePath) }}?v={{ random(100000, 999999) }}"
                                    alt="{{ localized(mainImage, 'altText')|default(productName) }}">
                            </a>
                        {% else %}
                            <img src="{{ asset('images/products-bg.jpg') }}?v={{ random(100000, 999999) }}"
                                alt="{{ productName }}">
                        {% endif %}
                    </div>
                    <div class="card-content-right">
                        <h3>{{ productName }}</h3>

                        {% set shortDescription = localized(product, 'shortDescription') %}
                        {% set description = localized(product, 'description') %}
                        {% if shortDescription %}
                            <p>{{ shortDescription|raw }}</p>
                        {% else %}
                            <p>
                               {{ description|striptags|slice(0, 320) }}{% if description|striptags|length > 320 %}...{% endif %}
                            </p>
                        {% endif %}

                        <a href="{{ path('product_detail', {categorySlug: localized_slug(category), slug: localized_slug(product)}) }}"
                           class="product-link">
                            {{ 'products.more'|trans }}
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            {% endfor %}

        {% endif %}

    </div>

</section>

<div id="lightbox" class="lightbox-overlay" hidden>
    <button type="button" class="lightbox-close" aria-label="{{ 'about.lightbox_close'|trans }}">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="{{ 'about.lightbox_prev'|trans }}">‹</button>
    <img src="" alt="">
    <button type="button" class="lightbox-next" aria-label="{{ 'about.lightbox_next'|trans }}">›</button>
</div>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/lightbox.js') }}"></script>
{% endblock %}
