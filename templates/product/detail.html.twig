{% extends 'base.html.twig' %}

{% set productName = localized(product, 'name') %}
{% set categoryName = localized(category, 'name') %}

{% block title %}
    {{ localized(product, 'metaTitle')|default(productName) }} | Pregotehnika
{% endblock %}

{% block meta_description %}
    {{ localized(product, 'metaDescription')|default(localized(product, 'shortDescription')|striptags|default(localized(product, 'description')|striptags|slice(0, 160))) }}
{% endblock %}

{% block body %}

<section class="product-section">

    <div class="container">

        {{ include('product/_breadcrumb.html.twig', {category: category, product: product}) }}

        <div class="text-center mb-5 faq-header">
            <h1 class="fw-bold text-navy">
                {{ productName }}
            </h1>
        </div>

        {% set mainImage = product.mainImage %}
        {% set hasGallery = product.images|length > 1 %}
        {% set hasDocuments = product.documents is not empty %}

        <div class="product-category-card product-detail-card">
            <div class="card-image-left">
                {% if mainImage %}
                    <a href="{{ asset('uploads/products/' ~ mainImage.imagePath) }}" class="lightbox">
                        <img src="{{ asset('uploads/products/' ~ mainImage.imagePath) }}?v={{ random(100000, 999999) }}"
                            alt="{{ localized(mainImage, 'altText')|default(productName) }}">
                    </a>
                {% else %}
                    <img src="{{ asset('images/products-bg.jpg') }}?v={{ random(100000, 999999) }}"
                        alt="{{ productName }}">
                {% endif %}
            </div>
            <div class="card-content-right">
                <h3>{{ productName }}</h3>

                <div class="product-description">
                    {{ localized(product, 'description')|raw }}
                </div>

                {% if hasDocuments %}
                    <ul class="product-document-list mt-3">
                        {% for document in product.documents|sort((a, b) => a.position <=> b.position) %}
                            <li>
                                {% if document.filePath %}
                                    <a href="{{ asset('uploads/documents/' ~ document.filePath) }}"
                                       target="_blank"
                                       rel="noopener">
                                        <i class="bi bi-file-earmark-text me-2"></i>
                                        {{ localized(document, 'title') }}
                                    </a>
                                {% else %}
                                    <span>
                                        <i class="bi bi-file-earmark-text me-2"></i>
                                        {{ localized(document, 'title') }}
                                    </span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if hasGallery %}
                    <div class="row g-2 product-gallery mt-3">
                        {% for image in product.images|sort((a, b) => a.position <=> b.position) %}
                            {% if not image.isMain %}
                                <div class="col-6">
                                    <a href="{{ asset('uploads/products/' ~ image.imagePath) }}"
                                       class="product-gallery-item lightbox">
                                        <img src="{{ asset('uploads/products/' ~ image.imagePath) }}"
                                             alt="{{ localized(image, 'altText')|default(productName) }}">
                                    </a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </div>

        <div class="text-center mt-4">
            <a href="{{ path('product_category', {slug: localized_slug(category)}) }}"
               class="product-link">
                <i class="bi bi-arrow-left"></i>
                {{ 'products.back_to'|trans({'%name%': categoryName}) }}
            </a>
        </div>

    </div>

</section>

<div id="lightbox" class="lightbox-overlay" hidden>
    <button type="button" class="lightbox-close" aria-label="{{ 'about.lightbox_close'|trans }}">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="{{ 'about.lightbox_prev'|trans }}">‹</button>
    <img src="" alt="">
    <button type="button" class="lightbox-next" aria-label="{{ 'about.lightbox_next'|trans }}">›</button>
</div>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/lightbox.js') }}"></script>
{% endblock %}
