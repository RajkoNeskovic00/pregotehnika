{% set category = category|default(null) %}
{% set product = product|default(null) %}

<nav aria-label="breadcrumb" class="product-breadcrumb-nav">
    <ol class="breadcrumb product-breadcrumb-list">
        <li class="breadcrumb-item">
            <a href="{{ path('home') }}">{{ 'products.breadcrumb_home'|trans }}</a>
        </li>

        <li class="breadcrumb-item {% if not category and not product %}active{% endif %}">
            {% if category or product %}
                <a href="{{ path('products') }}">{{ 'products.breadcrumb_products'|trans }}</a>
            {% else %}
                <span aria-current="page">{{ 'products.breadcrumb_products'|trans }}</span>
            {% endif %}
        </li>

        {% if category %}
            <li class="breadcrumb-item {% if not product %}active{% endif %}">
                {% if product %}
                    <a href="{{ path('product_category', {slug: localized_slug(category)}) }}">{{ localized(category, 'name') }}</a>
                {% else %}
                    <span class="breadcrumb-item-current" aria-current="page">{{ localized(category, 'name') }}</span>
                {% endif %}
            </li>
        {% endif %}

        {% if product %}
            <li class="breadcrumb-item active">
                <span class="breadcrumb-item-current" aria-current="page">{{ localized(product, 'name') }}</span>
            </li>
        {% endif %}
    </ol>
</nav>
